# Copy these into Railway → your service → Variables (do NOT commit real values).
# The app runs fine with any of these missing — that integration is simply skipped.

# ---- Supabase (database) ----
# From Supabase dashboard → Project Settings → API. Use the SERVICE ROLE key (server-side only).
SUPABASE_URL=https://jihbtcodhazjxqkrwyeu.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-secret-key
SUPABASE_TABLE=hvac_submissions

# ---- Mailgun (email notifications) ----
MAILGUN_API_KEY=your-mailgun-private-api-key
MAILGUN_DOMAIN=mg.samyouusa.com
MAILGUN_REGION=us
MAIL_FROM=HVAC Requests <requests@mg.samyouusa.com>
MAIL_TO=buzzardontree@gmail.com
MAIL_REPLY_TO_SUBMITTER=true

# ---- CORS (optional) ----
# Only needed if you ever serve index.html from a DIFFERENT origin than this app
# (e.g. the page on Hostinger, API here). Comma-separated. Leave empty for same-origin.
ALLOWED_ORIGINS=
